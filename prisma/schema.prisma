generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum InventoryKind {
  BEER
  INGREDIENT
  PACKAGING
  OTHER
}

enum MovementType {
  PURCHASE
  PRODUCTION
  SALE
  CONSUMPTION
  WASTE
  BREAKAGE
  RETURN
  ADJUSTMENT
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

enum BatchStatus {
  PLANNED
  BREWING
  FERMENTING
  CONDITIONING
  BOTTLED
  INTERNAL_TRIAL
  RELEASED
  DISCARDED
}

model User {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  role         Role                @default(OPERATOR)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  sales        Sale[]
  purchases    Purchase[]
  expenses     Expense[]
  movements    InventoryMovement[]
  auditLogs    AuditLog[]
}

model Product {
  id            String           @id @default(cuid())
  name          String
  beerType      String
  style         String?
  flavorProfile String?
  description   String?
  status        ProductStatus    @default(DRAFT)
  imageUrl      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
}

model ProductVariant {
  id                    String              @id @default(cuid())
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  label                 String
  volumeMl              Int
  sku                   String              @unique
  price                 Decimal             @db.Decimal(12, 2)
  estimatedUnitCost     Decimal?            @db.Decimal(12, 2)
  minimumStock          Int                 @default(0)
  stock                 Int                 @default(0)
  commerciallyAvailable Boolean             @default(false)
  createdAt             DateTime            @default(now())
  barcodes              Barcode[]
  saleItems             SaleItem[]
  inventoryMovements    InventoryMovement[]

  @@index([productId])
}

model Barcode {
  id        String         @id @default(cuid())
  value     String         @unique
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())

  @@index([variantId])
}

model Ingredient {
  id                String              @id @default(cuid())
  name              String
  unit              String
  kind              InventoryKind       @default(INGREDIENT)
  quantity          Decimal             @default(0) @db.Decimal(14, 3)
  minimumQuantity   Decimal             @default(0) @db.Decimal(14, 3)
  unitCost          Decimal?            @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  purchaseItems     PurchaseItem[]
  movements         InventoryMovement[]
  recipeIngredients RecipeIngredient[]
  batchConsumptions BatchConsumption[]
}

model Supplier {
  id        String     @id @default(cuid())
  name      String     @unique
  contact   String?
  purchases Purchase[]
  expenses  Expense[]
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        PurchaseStatus @default(RECEIVED)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  detail        String?
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]
  expense       Expense?

  @@index([createdAt])
}

model PurchaseItem {
  id                 String              @id @default(cuid())
  purchaseId         String
  purchase           Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  ingredientId       String
  ingredient         Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity           Decimal             @db.Decimal(14, 3)
  unitCost           Decimal             @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  inventoryMovements InventoryMovement[]

  @@index([ingredientId])
}

model Expense {
  id            String        @id @default(cuid())
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @default(now())
  paymentMethod PaymentMethod
  detail        String?
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchaseId    String?       @unique
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([date, category])
}

model Recipe {
  id              String             @id @default(cuid())
  name            String
  plannedVolumeMl Int
  notes           String?
  createdAt       DateTime           @default(now())
  ingredients     RecipeIngredient[]
  batches         ProductionBatch[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(14, 3)

  @@unique([recipeId, ingredientId])
}

model ProductionBatch {
  id               String              @id @default(cuid())
  code             String              @unique
  recipeId         String?
  recipe           Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  status           BatchStatus         @default(PLANNED)
  plannedVolumeMl  Int
  producedVolumeMl Int?
  sellableUnits    Int                 @default(0)
  lossVolumeMl     Int                 @default(0)
  startedAt        DateTime?
  bottledAt        DateTime?
  releasedAt       DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  consumptions     BatchConsumption[]
  movements        InventoryMovement[]

  @@index([status])
}

model BatchConsumption {
  id           String          @id @default(cuid())
  batchId      String
  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(14, 3)
  unitCost     Decimal         @db.Decimal(12, 2)
}

model InventoryMovement {
  id             String           @id @default(cuid())
  type           MovementType
  quantity       Decimal          @db.Decimal(14, 3)
  note           String?
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  ingredientId   String?
  ingredient     Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  saleItemId     String?
  purchaseItemId String?
  purchaseItem   PurchaseItem?    @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())
  saleItem       SaleItem?        @relation(fields: [saleItemId], references: [id])

  @@index([createdAt])
  @@index([variantId, createdAt])
  @@index([ingredientId, createdAt])
}

model Sale {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())
  items          SaleItem[]
  payment        Payment?

  @@index([createdAt])
}

model SaleItem {
  id                   String              @id @default(cuid())
  saleId               String
  sale                 Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variantId            String
  variant              ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productNameSnapshot  String
  variantLabelSnapshot String
  skuSnapshot          String
  unitPrice            Decimal             @db.Decimal(12, 2)
  quantity             Int
  discount             Decimal             @default(0) @db.Decimal(12, 2)
  lineTotal            Decimal             @db.Decimal(12, 2)
  movements            InventoryMovement[]
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String        @unique
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
